# BARSAN R35.2.3 — Variables خصوصی Railway
# این فایل فقط نمونه است. کلیدها و رمزهای واقعی را داخل GitHub قرار ندهید.

APP_NAME=Barsan AI Chatbot
ENVIRONMENT=production
PORT=8080
DATA_DIR=/data
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:////data/barsan.db
UPLOAD_DIR=/data/uploads
UPLOAD_SESSION_DIR=/data/upload-sessions
BACKUP_DIR=/data/backups
MAX_UPLOAD_MB=500
UPLOAD_CHUNK_MB=8
UPLOAD_SESSION_TTL_HOURS=24
GOOGLE_DOC_MAX_MB=100
MAX_ARCHIVE_EXPANDED_MB=500
MAX_PDF_PAGES=500
MIN_EXTRACTED_TEXT_CHARS=40
BACKGROUND_DOCUMENT_PROCESSING=true
SQLITE_SINGLE_REPLICA_MODE=true
SQLITE_REPLICA_LOCK_ENABLED=true
ORIGIN_GUARD_ENABLED=true
CONTENT_SECURITY_POLICY_ENABLED=true

# امنیت و حساب مالک
JWT_SECRET=
# کلید مستقل برای رمزگذاری APIهای ذخیره‌شده در SQLite؛ حداقل 32 کاراکتر و ثابت بین Deployها
PROVIDER_KEY_ENCRYPTION_SECRET=
# فقط IP/CIDR پراکسی‌هایی که اجازه دارند X-Forwarded-* را تعیین کنند؛ از * فقط آگاهانه استفاده کنید
TRUSTED_PROXY_IPS=127.0.0.1
JWT_EXPIRE_MINUTES=720
COOKIE_SECURE=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=مدیر بارسان
MASTER_ADMIN_USERNAME=admin
MASTER_ADMIN_EMAIL=admin@example.com
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_WINDOW_MINUTES=15
LOCAL_TIMEZONE_OFFSET_MINUTES=210
ALLOWED_ORIGINS=
PUBLIC_REGISTRATION_ENABLED=false

# OpenAI-compatible API pool — هر اسلات می‌تواند سرویس/کلید/مدل مستقل داشته باشد
AI_PROVIDER=openai_compatible
# نام‌های legacy فقط برای سازگاری؛ در استقرار جدید AI_API_KEY_1 را ترجیح دهید.
GAPGPT_API_KEY=
OPENAI_API_KEY=
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_TOKEN_PARAMETER=auto
AI_SEND_TEMPERATURE=true
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
AI_EXTRA_HEADERS_JSON={}
AI_TIMEOUT_SECONDS=75
AI_MAX_RETRIES=1
AI_MAX_COMPLETION_TOKENS=2400
AI_DEFAULT_MAX_COMPLETION_TOKENS=520
AI_DETAILED_MAX_COMPLETION_TOKENS=2400
AI_DEFAULT_MAX_ANSWER_CHARS=900
AI_DETAILED_MAX_ANSWER_CHARS=12000
AI_TEMPERATURE=0.05
AI_CONTINUATION_ROUNDS=1
AI_ENFORCE_DETAILED_ANSWER=false
AI_MIN_RESPONSE_CHARS=120
AI_ROTATE_ON_TRANSIENT_ERRORS=true
AI_KEY_RATE_LIMIT_COOLDOWN_SECONDS=1800
AI_KEY_QUOTA_COOLDOWN_SECONDS=86400
AI_KEY_TRANSIENT_COOLDOWN_SECONDS=120

# API 1 — GapGPT
AI_API_KEY_1=
AI_BASE_URL_1=https://api.gapgpt.app/v1
AI_MODEL_1=gpt-4o
AI_MODEL_ECONOMY_1=gpt-4o
AI_MODEL_STANDARD_1=gpt-4o
AI_MODEL_ADVANCED_1=gpt-4o
AI_PROVIDER_LABEL_1=GapGPT
AI_INPUT_COST_PER_1M_1=0
AI_OUTPUT_COST_PER_1M_1=0
AI_CREDIT_AMOUNT_1=0
AI_CREDIT_CURRENCY_1=IRR

# API 2 — Google Gemini via OpenAI-compatible endpoint
AI_API_KEY_2=
AI_BASE_URL_2=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL_2=gemini-3.5-flash
AI_MODEL_ECONOMY_2=gemini-3.1-flash-lite
AI_MODEL_STANDARD_2=gemini-3.5-flash
AI_MODEL_ADVANCED_2=gemini-3.5-flash
AI_PROVIDER_LABEL_2=Google Gemini
AI_INPUT_COST_PER_1M_2=0
AI_OUTPUT_COST_PER_1M_2=0
AI_CREDIT_AMOUNT_2=0
AI_CREDIT_CURRENCY_2=USD

# API 3 — OpenRouter
AI_API_KEY_3=
AI_BASE_URL_3=https://openrouter.ai/api/v1
AI_MODEL_3=openrouter/auto
AI_MODEL_ECONOMY_3=openrouter/auto
AI_MODEL_STANDARD_3=openrouter/auto
AI_MODEL_ADVANCED_3=openrouter/auto
AI_PROVIDER_LABEL_3=OpenRouter
AI_INPUT_COST_PER_1M_3=0
AI_OUTPUT_COST_PER_1M_3=0
AI_CREDIT_AMOUNT_3=0
AI_CREDIT_CURRENCY_3=USD

# API 4 — SambaNova Cloud
AI_API_KEY_4=
AI_BASE_URL_4=https://api.sambanova.ai/v1
AI_MODEL_4=gpt-oss-120b
AI_MODEL_ECONOMY_4=Meta-Llama-3.3-70B-Instruct
AI_MODEL_STANDARD_4=gpt-oss-120b
AI_MODEL_ADVANCED_4=gpt-oss-120b
AI_PROVIDER_LABEL_4=SambaNova Cloud
AI_INPUT_COST_PER_1M_4=0
AI_OUTPUT_COST_PER_1M_4=0
AI_CREDIT_AMOUNT_4=0
AI_CREDIT_CURRENCY_4=USD

# API 5 — OpenRouter Backup A
AI_API_KEY_5=
AI_BASE_URL_5=https://openrouter.ai/api/v1
AI_MODEL_5=openrouter/auto
AI_MODEL_ECONOMY_5=openrouter/auto
AI_MODEL_STANDARD_5=openrouter/auto
AI_MODEL_ADVANCED_5=openrouter/auto
AI_PROVIDER_LABEL_5=OpenRouter Backup A
AI_INPUT_COST_PER_1M_5=0
AI_OUTPUT_COST_PER_1M_5=0
AI_CREDIT_AMOUNT_5=0
AI_CREDIT_CURRENCY_5=USD

# API 6 — OpenRouter Backup B
AI_API_KEY_6=
AI_BASE_URL_6=https://openrouter.ai/api/v1
AI_MODEL_6=openrouter/auto
AI_MODEL_ECONOMY_6=openrouter/auto
AI_MODEL_STANDARD_6=openrouter/auto
AI_MODEL_ADVANCED_6=openrouter/auto
AI_PROVIDER_LABEL_6=OpenRouter Backup B
AI_INPUT_COST_PER_1M_6=0
AI_OUTPUT_COST_PER_1M_6=0
AI_CREDIT_AMOUNT_6=0
AI_CREDIT_CURRENCY_6=USD

# سازگاری با حالت تک‌سرویس؛ Pool بالا حالت اصلی است
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_PROVIDER_LABEL=

# سازگاری مستقیم Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRIES=2


# سازگاری مستقیم OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto


# سازگاری مستقیم SambaNova Cloud
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=gpt-oss-120b

# پنج مسیر پاسخ‌گویی و انتخاب مدل
MODEL_ROUTING_ENABLED=true
MODEL_ROUTE_SIMPLE_MAX_WORDS=24
MODEL_ROUTE_MULTI_SOURCE_THRESHOLD=3
MODEL_ROUTE_COMPLEX_KEYWORDS=مقایسه,تحلیل,مرحله به مرحله,جزئیات,کامل,دقیق,علت,سناریو,استثنا

# R35.2 — تجزیه‌وتحلیل عمیق + Capability Registry + Rerank مدل‌محور
DEEP_QUERY_ANALYSIS_ENABLED=true
DEEP_MULTI_RETRIEVAL_ENABLED=true
DEEP_MULTI_RETRIEVAL_MAX_QUERIES=6
DEEP_SEMANTIC_RERANK_ENABLED=true
# pre-ranker deterministic همیشه فعال می‌ماند؛ این مرحله برای سؤال‌های پیچیده top-k را با مدل دوباره مرتب می‌کند
MODEL_SEMANTIC_RERANK_ENABLED=true
MODEL_SEMANTIC_RERANK_MIN_COMPLEXITY=0.55
MODEL_SEMANTIC_RERANK_MAX_ITEMS=12
MODEL_SEMANTIC_RERANK_MAX_TOKENS=360
DEEP_RULE_ENGINE_ENABLED=true
# قابلیت هر اسلات را صریح Override کنید؛ نمونه: {"3":{"reasoning_mode":"reasoning"}}
AI_PROVIDER_CAPABILITIES_JSON={}
AI_REASONING_ENABLED=true
AI_REASONING_EFFORT_STANDARD=medium
AI_REASONING_EFFORT_ADVANCED=high
# auto: برای OpenRouter از reasoning و برای OpenAI-compatibleهای دیگر از reasoning_effort استفاده می‌کند
AI_REASONING_PARAMETER=auto
AI_REASONING_SEND_TEMPERATURE=false
DEEP_ANSWER_VERIFICATION_ENABLED=true
DEEP_CONFIDENCE_GATE_ENABLED=true
DEEP_CONFIDENCE_MIN=0.48
DEEP_CONFIDENCE_COMPLEX_MIN=0.56
CONFIDENCE_CALIBRATION_ENABLED=true
CONFIDENCE_CALIBRATION_MIN_CASES=12
CONFIDENCE_CALIBRATION_MAX_SHIFT=0.10

# FAQ و کش بدون مصرف توکن
FAQ_FUZZY_THRESHOLD=0.84
FAQ_MAX_ROWS=5000
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_MAX_ROWS=20000
ANSWER_CACHE_MAX_AGE_DAYS=30
ANSWER_CACHE_FUZZY_THRESHOLD=0.97
ANSWER_CACHE_FUZZY_CANDIDATES=120
ANSWER_CACHE_NAMESPACE=barsan-r35-2-2-openrouter-pool6
APPROVED_CACHE_MAX_ROWS=10000
TEMPORARY_CACHE_HOURS=24
TEMPORARY_CACHE_MAX_ROWS=2000

# آموزش، منابع و تحلیل مستقل مدل
DIRECT_TRAINING_ANSWER_ENABLED=true
TRAINING_RELEVANCE_MIN_SCORE=0.08
TRAINING_STAGE_MIN_SCORE=0.22
TRAINING_RESCUE_SCAN_LIMIT=5000
DIRECT_TRAINING_MIN_SCORE=0.72
MANAGER_TRAINING_REQUIRES_APPROVAL=false
SELF_ANALYSIS_ENABLED=true
KNOWLEDGE_GAP_NOTIFY_THRESHOLD=2

# جست‌وجوی ترکیبی فارسی: FTS/BM25 + نمایه معنایی محلی
SEMANTIC_SEARCH_ENABLED=true
SEMANTIC_BUCKET_LIMIT=28
SEMANTIC_CANDIDATE_LIMIT=500
RETRIEVAL_TOP_K=12
RETRIEVAL_TOTAL_ITEMS=16
RETRIEVAL_MIN_SCORE=0.08
RETRIEVAL_MEDIUM_CONFIDENCE=0.30
RETRIEVAL_HIGH_CONFIDENCE=0.62
RETRIEVAL_NEIGHBOR_CHUNKS=3
RETRIEVAL_MAX_CONTEXT_CHARS=36000
RETRIEVAL_SCAN_LIMIT=8000
RETRIEVAL_CHUNK_SIZE=1700
RETRIEVAL_CHUNK_OVERLAP=320

# حافظه کوتاه مکالمه
CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MEMORY_MESSAGES=4
CONVERSATION_MEMORY_MAX_CHARS=1400

# محدودیت مهمان و Integration؛ سهمیه کاربران ثبت‌شده از پنل مدیریت تعیین می‌شود
REQUESTS_PER_MINUTE=30
GUEST_CHAT_ENABLED=true
GUEST_REQUESTS_PER_MINUTE=20
GUEST_DAILY_LIMIT=100
GUEST_MONTHLY_LIMIT=1000
INTEGRATION_DAILY_LIMIT=5000
RATE_LIMIT_RETENTION_DAYS=45
SQLITE_CACHE_KB=64000
SQLITE_MMAP_MB=128
# نمونه: {"site":"یک-کلید-تصادفی-حداقل-24-کاراکتر"}
INTEGRATION_API_KEYS={}
# دامنه‌هایی که اجازه دارند /widget را داخل iframe نمایش دهند (با کاما جدا کنید)
WIDGET_ALLOWED_ORIGINS=

# سلامت، هشدار و پشتیبان‌گیری
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_INTERVAL_SECONDS=300
HEALTH_DISK_WARNING_PERCENT=85
HEALTH_ERROR_RATE_WARNING_PERCENT=25
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_RETENTION=7
BACKUP_OVERDUE_WARNING_HOURS=36
BACKUP_MAX_MB=2048

EXPORT_ROW_LIMIT=100000
BARSAN_RELEASE=R35_2_3_PREDEPLOY_OVERRIDE

# R23 — تمرکز سخت‌گیرانه روی منابع و بررسی تصاویر PDF
SOURCE_FIRST_STRICT=true
SOURCE_ANSWER_VERIFICATION=true
SOURCE_VERIFICATION_MAX_TOKENS=700
PDF_VISION_ENABLED=true

# Source Ingestion 2.0 — R28
PDF_VISION_SCAN_ALL_PAGES=true
PDF_VISION_CONCURRENCY=4
SOURCE_INGESTION_V3=true
SOURCE_INGESTION_V2=false
SOURCE_INCLUDE_PARTIAL_DOCUMENTS=false
SOURCE_MIN_QUALITY_PCT=92
# R35.2: علاوه بر کیفیت کلی، وفاداری صفحه و تطابق عدد/واحد باید از Gate عبور کنند
SOURCE_MIN_PAGE_FIDELITY=0.82
SOURCE_MIN_NUMERIC_AGREEMENT=0.72
AUTO_REINDEX_LEGACY_SOURCES=true
AUTO_REINDEX_LEGACY_LIMIT=100
SOURCE_PAGE_STORAGE_ENABLED=true
SOURCE_STRUCTURE_AWARE_INDEXING=true
SOURCE_NUMERIC_FACT_BOOST=0.14
PDF_VISION_MAX_PAGES=500
PDF_VISION_DPI=180
PDF_VISION_MIN_TEXT_CHARS=100
PDF_VISION_MAX_RENDER_MB=5
PDF_VISION_MAX_TOKENS=2400
# مدل‌های تصویری: اسلات بدون مدل تصویری رد می‌شود و اسلات بعدی امتحان می‌شود
AI_VISION_MODEL_1=gpt-4o
AI_VISION_MODEL_2=gemini-3.5-flash
AI_VISION_MODEL_3=google/gemini-2.5-flash
AI_VISION_MODEL_4=Llama-4-Maverick-17B-128E-Instruct
AI_VISION_MODEL_5=
AI_VISION_MODEL_6=

# تبدیل گفتار به متن برای آموزش و FAQ
TRANSCRIPTION_MAX_MB=20
AI_TRANSCRIPTION_MODEL_1=whisper-1
AI_TRANSCRIPTION_MODEL_2=
AI_TRANSCRIPTION_MODEL_3=
AI_TRANSCRIPTION_MODEL_4=
AI_TRANSCRIPTION_MODEL_5=
AI_TRANSCRIPTION_MODEL_6=


CHAT_UNIFIED_KNOWLEDGE_MODE=true
CHAT_DISABLE_SECTION_REDIRECTS=true
CHAT_CORPUS_RESCUE_ENABLED=true
CHAT_CORPUS_RESCUE_LIMIT=8000
CHAT_REDIRECT_RETRY_MAX_TOKENS=650

# R29 — RAG 3.0 / Smart Source Ingestion / Durable Jobs
PDF_VISION_SCAN_IMAGE_PAGES=true
PDF_VISION_SCAN_TABLE_LIKE_PAGES=true
REMOTE_EMBEDDING_ENABLED=true
EMBEDDING_API_SLOT=3
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CHARS=6000
EMBEDDING_SCAN_LIMIT=20000
EMBEDDING_TIMEOUT_SECONDS=75
EMBEDDING_QUERY_SKIP_CONFIDENCE=0.52
HYBRID_RERANK_ENABLED=true
HYBRID_RERANK_TOP_N=32
SOURCE_FACT_EXTRACTION_ENABLED=true
FACT_RETRIEVAL_LIMIT=60
RETRIEVAL_DEBUG_MAX_ITEMS=30
DOCUMENT_JOB_WORKER_ENABLED=true
DOCUMENT_JOB_POLL_SECONDS=1.5
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_JOB_STALE_SECONDS=900
GOLDEN_EVAL_ENABLED=true
GOLDEN_EVAL_MIN_PASS_PERCENT=90
GOLDEN_MIN_TOKEN_RECALL=0.55
GOLDEN_MAX_CASES=500
# Railway deployment hardening
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=600
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30


# اعمال ایمیل و رمز ادمین اصلی روی دیتابیس موجود در Startup
SYNC_MASTER_ADMIN_CREDENTIALS=false

# R29.6 — موتورهای عملیاتی + فهرست دقیق خودروهای بررسی بار
NESHAN_API_KEY=
NESHAN_GEOCODING_URL=https://api.neshan.org/geocoding/v1
NESHAN_SEARCH_URL=https://api.neshan.org/v3/search
NESHAN_USE_PLUS=true
NESHAN_SEARCH_ENRICHMENT=true
NESHAN_TIMEOUT_SECONDS=10
NESHAN_MAX_RESULTS=5
NESHAN_CACHE_TTL_DAYS=30
# پروفایل‌های ابعاد خودرو اختیاری؛ در صورت خالی بودن، مدیر یک‌بار از پنل ثبت می‌کند.
CARGO_VEHICLE_PROFILES_JSON={}

SOURCE_PAGE_BY_PAGE_STRICT=true

# R32 Speed Engine + Built-in Sources
FAST_EXACT_CACHE_ENABLED=true
RETRIEVAL_STAGE_CACHE_TTL_SECONDS=300
RETRIEVAL_STAGE_CACHE_MAX_ENTRIES=800
PROVIDER_SPEED_ROUTING_ENABLED=true
PROVIDER_SPEED_CACHE_SECONDS=30
PROVIDER_SPEED_MIN_SAMPLES=2
PDF_VISION_BALANCE_PROVIDERS=true
PDF_VISION_DELTA_MODE=true
PDF_VISION_DELTA_TEXT_THRESHOLD=700
SOURCE_VERIFICATION_FAST_GUARD=true

# R31 dynamic API pool
MAX_AI_API_SLOTS=20

# R32 — چهار جزوه پایه داخلی با اولویت آموزش مدیر
BUILTIN_SOURCE_AUTO_INSTALL=true
BUILTIN_SOURCE_AUTO_ENRICH=false
BUILTIN_SOURCE_GLOBAL_DEFAULT=true

# R35.2 cargo visual training
CARGO_IMAGE_MAX_MB=12
